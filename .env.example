# Copy this file to .env (same folder) and fill it in. .env is gitignored: never commit it.
# Values in .env win over variables already set in Windows. Blank lines and lines starting
# with # are ignored, so you only need to fill in what you use.

# Claude API key (console.anthropic.com > API Keys). Web search must be enabled for your org.
ANTHROPIC_API_KEY=

# Supabase project URL: Dashboard > Project Settings > Data API (or the "Connect" button).
SUPABASE_URL=
# Publishable (anon) key: Project Settings > API Keys. The browser gets this one; it's safe
# to expose because row-level security protects the data.
SUPABASE_ANON_KEY=
# Secret (service_role) key: same page. Server only. It bypasses row-level security,
# so never put it in frontend code or share it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional settings (remove the # to use one)
# Research + draft jobs per UTC day across all users, as a spending backstop. Default 100.
# SOCIAI_GLOBAL_DAILY_LIMIT=100
# Model per step. Default claude-sonnet-5-5.
# SOCIAI_RESEARCH_MODEL=claude-sonnet-5-5
# SOCIAI_DRAFT_MODEL=claude-sonnet-5-5
# Behind a proxy such as Render, take the client IP from X-Forwarded-For (used for the
# 3-new-accounts-per-IP-per-day limit). Leave off locally.
# SOCIAI_TRUST_PROXY=1
# New accounts per IP per day before the next one is blocked. Default 3; campus and office networks
# share one IP, so raise it if real users hit "Too many new accounts were created from your network".
# SOCIAI_MAX_ACCOUNTS_PER_IP=3
# Set by Render. Locally the server listens on 127.0.0.1:8000.
# PORT=8000
# Research budget per run (the main cost lever). Defaults 5 searches and 8 page fetches.
# SOCIAI_MAX_SEARCHES=5
# SOCIAI_MAX_FETCHES=8
# Optional error monitoring with Sentry. Unset = off. Events never include resumes, samples,
# request bodies or keys.
# SENTRY_DSN=

# Payments (Stripe). Leave these out to run without payments.
# test (default) or live. The key below must match: sk_test_/rk_test_ for test, sk_live_/rk_live_
# for live. A mismatch turns payments off (the startup log says why).
# SOCIAI_STRIPE_MODE=test
# Secret key: Stripe dashboard > Developers > API keys (in the same mode).
# STRIPE_SECRET_KEY=
# Locally: the whsec_... secret that `stripe listen` prints. On Render: the webhook endpoint's secret.
# STRIPE_WEBHOOK_SECRET=
# Price ids (price_...) from Products: the 20-credit pack and the monthly plan.
# STRIPE_PRICE_PACK=
# STRIPE_PRICE_MONTHLY=
# Where Stripe sends people back to after Checkout and the portal. Defaults to the Render URL,
# else http://localhost:8000.
# PUBLIC_URL=http://localhost:8000
