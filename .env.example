# Copy this file to .env (same folder) and fill it in. .env is gitignored: never commit it.
# Values in .env win over variables already set in Windows. Blank lines and lines starting
# with # are ignored, so you only need to fill in what you use.

# Claude API key (console.anthropic.com > API Keys). Web search must be enabled for your org.
ANTHROPIC_API_KEY=

# Supabase project URL: Dashboard > Project Settings > Data API (or the "Connect" button).
SUPABASE_URL=
# Publishable (anon) key: Project Settings > API Keys. The browser gets this one; it's safe
# to expose because row-level security protects the data.
SUPABASE_ANON_KEY=
# Secret (service_role) key: same page. Server only. It bypasses row-level security,
# so never put it in frontend code or share it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional settings (remove the # to use one)
# Research + draft jobs per UTC day across all users, as a spending backstop. Default 100.
# SOCIAI_GLOBAL_DAILY_LIMIT=100
# Model per step. Default claude-sonnet-5-5.
# SOCIAI_RESEARCH_MODEL=claude-sonnet-5-5
# SOCIAI_DRAFT_MODEL=claude-sonnet-5-5
# Behind a proxy such as Render, take the client IP from X-Forwarded-For (used for the
# 3-new-accounts-per-IP-per-day limit). Leave off locally.
# SOCIAI_TRUST_PROXY=1
# Set by Render. Locally the server listens on 127.0.0.1:8000.
# PORT=8000
